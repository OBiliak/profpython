# Copy to .env and change the values: cp .env.example .env
# .env is in .gitignore; real passwords, tokens and keys are never written here or in Git.
APP_NAME=Car Catalog
# development | test | production
ENVIRONMENT=development
DATABASE_URL=sqlite:///car_catalog.db
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
# fill an empty database with 5 manufacturers and 10 cars at startup
SEED_DEMO_DATA=true
